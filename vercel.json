{
  "version": 2,
  "builds": [
    {
      "src": "**/*",
      "use": "@cloudflare/static"
    }
  ],
  "routes": [
    { "src": "/en/", "dest": "/index.html" },
    { "src": "/zh/", "dest": "/index.html" },
    { "src": "/assets/*", "dest": "/assets/$1" },
    { "src": "/js/*", "dest": "/js/$1" },
    { "src": "/i18n/*", "dest": "/i18n/$1" },
    { "src": "/privacy", "dest": "/index.html" },
    { "src": "/terms", "dest": "/index.html" },
    { "src": "/disclaimer", "dest": "/index.html" }
  ]
}